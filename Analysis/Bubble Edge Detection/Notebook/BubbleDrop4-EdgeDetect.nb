Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Converting", " ", "pixel", " ", "coordinates", " ", "into", " ", "polar", 
    " ", "coordinates"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"polarCoords", "=", 
     RowBox[{"VideoMapTimeSeries", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"frame", ",", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"img", ",", "coords", ",", "centroid"}], "}"}], ",", 
           RowBox[{
            RowBox[{"img", "=", 
             RowBox[{"Binarize", "[", 
              RowBox[{"frame", "[", "\"\<Image\>\"", "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"coords", "=", 
             RowBox[{"PixelValuePositions", "[", 
              RowBox[{"img", ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
            
            RowBox[{"centroid", "=", 
             RowBox[{"Mean", "[", "coords", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"Reverse", "@", 
               RowBox[{"ToPolarCoordinates", "@", 
                RowBox[{"(", 
                 RowBox[{"#", "-", "centroid"}], ")"}]}]}], "&"}], "/@", 
             "coords"}]}]}], "]"}]}], "]"}], ",", "edge"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{
  4.0032539088301487`*^9, {4.003299609882958*^9, 4.003299613802402*^9}, {
   4.0033057242575006`*^9, 4.0033057268230677`*^9}, {4.003307380238874*^9, 
