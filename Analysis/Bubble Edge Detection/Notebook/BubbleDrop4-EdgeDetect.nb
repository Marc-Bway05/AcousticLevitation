Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Finding", " ", "the", " ", 
    RowBox[{"no", ".", " ", "white"}], " ", "pixels", " ", 
    RowBox[{"(", "area", ")"}], " ", "for", " ", "each", " ", "frame"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"area", "=", 
    RowBox[{"VideoMapTimeSeries", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"ImageData", "[", 
           RowBox[{"Binarize", "[", "#Image", "]"}], "]"}], "]"}], ",", "1"}],
         "]"}], "&"}], ",", "bubble"}], "]"}]}], "\[IndentingNewLine]", 
