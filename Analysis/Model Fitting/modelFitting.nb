Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"fitting", " ", "decaying", " ", "sinusoid"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{"dataCos", "=", 
   RowBox[{"NonlinearModelFit", "[", "\[IndentingNewLine]", 
    RowBox[{"data", ",", "\[IndentingNewLine]", 
     RowBox[{"1.84", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", "72"}], "*", "x"}], "]"}], "*", 
      RowBox[{"Abs", "[", 
       RowBox[{"Cos", "[", 
        RowBox[{
         RowBox[{"omega", "*", "x"}], "+", "phi"}], "]"}], "]"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"omega", ",", "250"}], "}"}], ",", 
       RowBox[{"{", "phi", "}"}]}], "}"}], ",", "\[IndentingNewLine]", "x"}], 
    "]"}]}]}]], "Input",
